<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include layout="@layout/view_back_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- Generated by the database, so it cannot be edited -->
            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/hint_session_id"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_marginTop="6dp"
                style="@style/Widget.EM.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_session_id">

                <com.google.android.material.textfield.TextInputEditText
                android:hint="@string/hint_session_id"
                    android:id="@+id/etSessionId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/hint_session_name"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSessionName"
                style="@style/Widget.EM.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="@string/hint_session_name">

                <com.google.android.material.textfield.TextInputEditText
                android:hint="@string/hint_session_name"
                    android:id="@+id/etSessionName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Clock icon opens a time picker; the time can also be typed -->
            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/hint_session_time"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSessionTime"
                style="@style/Widget.EM.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="@string/hint_session_time"
                app:endIconContentDescription="@string/pick_time"
                app:endIconDrawable="@drawable/ic_schedule"
                app:endIconMode="custom">

                <com.google.android.material.textfield.TextInputEditText
                android:hint="@string/hint_session_time"
                    android:id="@+id/etSessionTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLength="5" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/hint_session_type"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.EM.TextInputLayout.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="@string/hint_session_type">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:hint="@string/hint_session_type"
                    android:id="@+id/actType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/hint_speaker"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.EM.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="@string/hint_speaker">

                <com.google.android.material.textfield.TextInputEditText
                android:hint="@string/hint_speaker"
                    android:id="@+id/etSpeaker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/hint_room"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.EM.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="@string/hint_room">

                <com.google.android.material.textfield.TextInputEditText
                android:hint="@string/hint_room"
                    android:id="@+id/etRoom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/hint_description"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.EM.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="@string/hint_description">

                <com.google.android.material.textfield.TextInputEditText
                android:hint="@string/hint_description"
                    android:id="@+id/etSessionDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_changes" />
    </LinearLayout>

</LinearLayout>
