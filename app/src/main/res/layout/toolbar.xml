<?xml version="1.0" encoding="utf-8"?>
<!-- Toolbar included by every screen except the home screen. Title is set in code. -->
<com.google.android.material.appbar.MaterialToolbar
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:background="@color/bg"
    android:theme="@style/ThemeOverlay.EM.Toolbar"
    app:titleTextAppearance="@style/TextAppearance.EM.ToolbarTitle"
    app:subtitleTextAppearance="@style/TextAppearance.EM.ToolbarSubtitle" />
