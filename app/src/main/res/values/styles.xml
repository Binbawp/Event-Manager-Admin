<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.EM.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/card</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="Widget.EM.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">27dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Widget.EM.Button.Dark">
        <item name="backgroundTint">@color/chip</item>
        <item name="android:textColor">@color/lime</item>
    </style>
    <style name="Widget.EM.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/lime</item>
        <item name="tint">@color/dark</item>
    </style>
    <style name="Widget.EM.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxBackgroundColor">@color/card</item>
        <item name="hintEnabled">false</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeColor">@color/em_box_stroke</item>
        <item name="hintTextColor">@color/lime</item>
    </style>
    <style name="Widget.EM.TextInputLayout.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxBackgroundColor">@color/card</item>
        <item name="hintEnabled">false</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeColor">@color/em_box_stroke</item>
        <item name="hintTextColor">@color/lime</item>
    </style>
    <style name="ThemeOverlay.EM.Toolbar" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="colorControlNormal">@color/lime</item>
    </style>
    <style name="TextAppearance.EM.ToolbarTitle" parent="TextAppearance.AppCompat.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="TextAppearance.EM.ToolbarSubtitle" parent="TextAppearance.AppCompat.Small">
        <item name="android:textColor">@color/muted</item>
    </style>
    <style name="EM.IconBtn" parent="">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_icon_btn</item>
        <item name="android:tint">@color/lime</item>
    </style>
    <style name="Widget.EM.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>
</resources>
